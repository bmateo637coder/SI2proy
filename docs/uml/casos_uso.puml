}
Super --> UC1
Super --> UC2
Super --|> Admin
Admin --> UC3
Admin --> UC4
Admin --|> Agent
Agent --> UC5
Agent --> UC6
Agent --> UC7
Agent --> UC9
Agent --> UC10
Agent --> UC11
Agent --> UC13
Agent --> UC14
Agent --> UC15
Agent --> UC16
Agent --> UC17
UC12 ..> UC17 : <<extend>>
UC7 ..> UC8 : <<include>>
UC11 ..> UC10 : <<include>>
