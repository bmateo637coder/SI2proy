  usecase "Configurar planes" as UC2
  usecase "Administrar suscripción" as UC3
  usecase "Gestionar sucursales\ny asignaciones" as UC4
  usecase "Descargar copia autorizada\n(automática en móvil)" as UC5
  usecase "Registrar reserva o venta\nen dispositivo" as UC6
  usecase "Sincronizar pendientes" as UC7
  usecase "Validar tenant, sucursal,\nversión y disponibilidad" as UC8
  usecase "Consultar resultado\ny resolver conflicto" as UC9
  usecase "Consultar reporte\nconvencional" as UC10
  usecase "Solicitar reporte\npor texto o voz" as UC11
  usecase "Exportar PDF, Excel,\nCSV o HTML" as UC12
  usecase "Consultar dashboard ML" as UC13
  usecase "Cancelar reserva\ndentro del plazo" as UC14
  usecase "Entrar sin conexión\ncon cuenta validada" as UC15
  usecase "Registrar contratos\ny pagos locales" as UC16
